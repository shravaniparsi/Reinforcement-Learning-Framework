{
  "name": "rl-rendering",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "train": "cd src/env && python train_ppo.py --mode train --episodes 5000",
    "evaluate": "cd src/env && python train_ppo.py --mode evaluate",
    "baselines": "cd src/env && python train_ppo.py --mode baselines",
    "experiment": "cd src/env && python experiment_runner.py --mode quick",
    "experiment:full": "cd src/env && python experiment_runner.py --mode full",
    "analyze": "cd src/env && python analyze_results.py"
  },
  "keywords": ["reinforcement-learning", "rendering-optimization", "nextjs", "web-performance"],
  "author": "",
  "license": "ISC",
  "description": "RL-based adaptive component rendering framework for full-stack web applications",
  "dependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
